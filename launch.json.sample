{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Server",
            "type": "python",
            "request": "launch",
            "program": "python_app/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "HM_CONFIG_FILE": "${workspaceFolder}/.local/browser-app.json"
            }
        }
    ]
}
